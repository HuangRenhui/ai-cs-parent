.user-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4d86ff 100%);
  box-shadow: 0 12rpx 28rpx rgba(47, 107, 255, 0.24);
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.24);
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
  line-height: 112rpx;
  text-align: center;
}

.user-name {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.user-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.85);
  font-size: 25rpx;
}

.menu {
  padding: 0 24rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f1f5f9;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 48rpx;
  font-size: 34rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #1c2b4a;
}

.menu-arrow {
  color: #c3ccda;
  font-size: 28rpx;
}

.logout {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  color: #b42318;
  border-color: #fecdca;
}
