.hero {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4d86ff 100%);
  box-shadow: 0 12rpx 28rpx rgba(47, 107, 255, 0.24);
}

.hero-mascot {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.22);
  color: #fff;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 96rpx;
  text-align: center;
}

.hero-title {
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 25rpx;
}

.grid {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  padding: 32rpx 0;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(16, 24, 40, 0.05);
}

.grid-item {
  flex: 1;
  text-align: center;
}

.grid-icon {
  width: 88rpx;
  height: 88rpx;
  margin: 0 auto 12rpx;
  border-radius: 24rpx;
  font-size: 40rpx;
  line-height: 88rpx;
  text-align: center;
}

.i-chat { background: #eef4ff; }
.i-help { background: #ecfdf3; }
.i-session { background: #fff8eb; }
.i-order { background: #f5f0ff; }

.grid-text {
  font-size: 26rpx;
  color: #374151;
}

.section-head {
  margin-bottom: 12rpx;
}

.list-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-top: 1rpx solid #f1f5f9;
}

.row-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c2b4a;
}

.foot-tip {
  text-align: center;
  color: #a6b0c0;
  font-size: 22rpx;
  padding: 24rpx 0 40rpx;
}
