.chat {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #eef2f7;
}

.msgs {
  flex: 1;
  padding: 24rpx;
  box-sizing: border-box;
}

.msg {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.msg.mine {
  align-items: flex-end;
}

.bubble {
  max-width: 72%;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: #fff;
  color: #1f2937;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.04);
}

.msg.mine .bubble {
  background: #2f6bff;
  color: #fff;
}

.time {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #a6b0c0;
}

.msg-bottom {
  height: 20rpx;
}

/* ===== 消息内附件 ===== */
.att-list {
  display: flex;
  flex-wrap: wrap;
  max-width: 72%;
  margin-bottom: 10rpx;
}

.att-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 14rpx;
  margin: 0 10rpx 10rpx 0;
  background: #fff;
}

.att-file {
  display: flex;
  align-items: center;
  gap: 12rpx;
  max-width: 440rpx;
  padding: 18rpx 22rpx;
  margin-bottom: 10rpx;
  border-radius: 14rpx;
  background: #fff;
  font-size: 26rpx;
  color: #374151;
  box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.04);
}

.att-file-icon {
  flex: none;
  font-size: 30rpx;
}

.att-file-name {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.att-file-size {
  flex: none;
  font-size: 22rpx;
  color: #a6b0c0;
}

/* ===== 待发送附件 ===== */
.pending-bar {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  padding: 16rpx 24rpx 0;
  background: #fff;
  align-items: center;
}

.pending-item {
  position: relative;
}

.pending-thumb {
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f4f7fb;
}

.pending-file {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  border-radius: 12rpx;
  background: #f4f7fb;
  font-size: 40rpx;
}

.pending-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 32rpx;
  text-align: center;
  border-radius: 50%;
  background: #f04438;
  color: #fff;
  font-size: 26rpx;
}

.pending-uploading {
  font-size: 24rpx;
  color: #a6b0c0;
}

/* ===== 输入栏 ===== */
.input-bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #eef2f7;
}

.attach-btn {
  flex: none;
  width: 80rpx;
  height: 80rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 50%;
  background: #f4f7fb;
  color: #6b7280;
  font-size: 44rpx;
}

.input {
  flex: 1;
  min-height: 80rpx;
  max-height: 240rpx;
  box-sizing: border-box;
  padding: 16rpx 28rpx;
  background: #f4f7fb;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.send-btn {
  flex: none;
  width: 150rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #2f6bff;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
  padding: 0;
}

/* ===== 附件来源面板 ===== */
.attach-mask {
  position: fixed;
  inset: 0;
  background: rgba(16, 24, 40, 0.45);
  z-index: 100;
  display: flex;
  align-items: flex-end;
}

.attach-panel {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 16rpx 0;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.attach-opt {
  padding: 30rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #1f2937;
  border-bottom: 1rpx solid #f4f7fb;
}

.attach-cancel {
  padding: 30rpx 0;
  text-align: center;
  font-size: 30rpx;
  color: #a6b0c0;
}

.empty-link {
  margin-top: 16rpx;
  color: #2f6bff;
  font-size: 26rpx;
}
