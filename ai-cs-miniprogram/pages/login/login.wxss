.login {
  min-height: 100vh;
  padding: 120rpx 48rpx 48rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #eaf1ff 0%, #eef2f7 42%, #eef2f7 100%);
}

.brand {
  text-align: center;
  margin-bottom: 60rpx;
}

.logo {
  width: 128rpx;
  height: 128rpx;
  margin: 0 auto 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(160deg, #4d86ff 0%, #2f6bff 100%);
  color: #fff;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 128rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(47, 107, 255, 0.28);
}

.brand-title {
  font-size: 40rpx;
  font-weight: 750;
  color: #1c2b4a;
}

.brand-sub {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #6b7280;
}

.input {
  height: 92rpx;
  background: #f4f7fb;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  font-size: 28rpx;
}

.submit {
  margin-top: 20rpx;
  height: 92rpx;
  line-height: 92rpx;
}

.btn-wechat {
  background: #07c160;
  color: #fff;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.tip {
  margin-top: 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #8a94a6;
  line-height: 1.6;
}
